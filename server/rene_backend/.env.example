# Réne Chatbot Backend API Environment Variables
# Copy this file to .env and fill in your keys.

# Primary Groq API Key
GROQ_API_KEY_1=gsk_...

# Secondary Groq API Key (Failover fallback key)
GROQ_API_KEY_2=gsk_...

# OpenRouter API Key (Tertiary fallback key)
OPENROUTER_API_KEY=sk-or-v1-...

# Mistral API Key (Quaternary fallback key)
MISTRAL_API_KEY=...
